# Copy to .env.local. Leave the Supabase values empty to run in demo mode
# (sample data, a role picker instead of login, nothing is saved).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Cloudflare Turnstile site key for public forms (optional locally)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Full public URL, including /tedxguc-portal on GitHub Pages
NEXT_PUBLIC_SITE_URL=
