# Copy to supabase/functions/.env for local development, or set each one
# with `supabase secrets set NAME=value` on the hosted project.
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are
# provided to server functions automatically.

# Public site address (used in email links and CORS)
SITE_URL=http://localhost:3000

# Resend (https://resend.com). Leave empty locally to print emails to the log.
RESEND_API_KEY=
EMAIL_FROM=TEDxGUC <tickets@your-domain>

# Cloudflare Turnstile secret. Leave empty locally to skip the check.
TURNSTILE_SECRET_KEY=

# Where partner/contact form messages are forwarded (optional)
INQUIRY_INBOX=

# Google sign-in (for supabase/config.toml, local only)
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
